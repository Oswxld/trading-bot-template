# Copy to .env and replace the placeholders (never commit your real .env).
# Each client website uses its OWN Deriv OAuth application.
CLIENT_ID=YOUR_DERIV_OAUTH_APP_ID

# Optional: configure only after the CLIENT has registered as a Deriv Partner.
# Use the client's trader signup referral token, NOT your Master Partner recruitment link.
# Example: https://t.deriv.link?t=ABC123 -> AFFILIATE_TOKEN=ABC123; AFFILIATE_TOKEN_PARAM=t
AFFILIATE_TOKEN=
AFFILIATE_TOKEN_PARAM=t

# From the client's Partners dashboard, if available.
AFFILIATE_ID=
AFFILIATE_CAMPAIGN=

# Production Vercel Function also requires this environment variable.
# It must match the Deriv OAuth registered redirect URI EXACTLY (no trailing slash).
# Leave it blank during local `npm start` development; it is not compiled into frontend JS.
OAUTH_REDIRECT_URI=

# Deployment: register the deployment's exact redirect URI with Deriv.
# Never copy secret tokens, personal API keys or trading access tokens into these fields.
